{
  "name": "@mdjhnson/homebridge-yoto",
  "displayName": "Homebridge Yoto",
  "description": "Control your Yoto players through Apple HomeKit with real-time MQTT updates",
  "version": "0.1.7",
  "author": "mdjhnson (https://github.com/mdjhnson)",
  "contributors": [
    "Bret Comnes <bcomnes@gmail.com> (https://bret.io)"
  ],
  "bugs": {
    "url": "https://github.com/mdjhnson/homebridge-yoto/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/mdjhnson"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "color-convert": "3.1.3",
    "yoto-nodejs-client": "^0.0.11"
  },
  "devDependencies": {
    "@types/node": "^25.9.8",
    "@voxpelli/tsconfig": "^16.2.1",
    "ajv": "^8.20.0",
    "auto-changelog": "^2.0.0",
    "c8": "^10.0.0",
    "eslint": "^9.39.2",
    "globals": "^17.12.0",
    "homebridge": "^2.4.0",
    "neostandard": "^0.12.0",
    "npm-run-all2": "^8.0.1",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "npm": ">=10",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "homepage": "https://github.com/mdjhnson/homebridge-yoto",
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge",
    "homekit",
    "yoto",
    "yoto-player",
    "yoto-mini"
  ],
  "license": "MIT",
  "type": "module",
  "module": "index.js",
  "main": "index.js",
  "files": [
    "index.js",
    "config.schema.json",
    "config.schema.cjs",
    "lib/",
    "!lib/**/*.test.js",
    "homebridge-ui/",
    "README.md",
    "LICENSE",
    "experiments/mediaremote/receiver.py",
    "experiments/mediaremote/requirements.txt",
    "experiments/mediaremote/THIRD_PARTY_LICENSES.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdjhnson/homebridge-yoto.git"
  },
  "scripts": {
    "test": "run-s test:*",
    "test:lint": "eslint",
    "test:tsc": "tsc",
    "test:node-test": "c8 node --test --test-reporter spec",
    "version": "run-s version:*",
    "version:changelog": "auto-changelog -p --template keepachangelog auto-changelog --breaking-pattern 'BREAKING CHANGE:'",
    "version:git": "git add CHANGELOG.md"
  },
  "c8": {
    "reporter": [
      "lcov",
      "text"
    ]
  }
}
